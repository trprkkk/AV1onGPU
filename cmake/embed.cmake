# AV1onGPU - embed the kernel sources into the library.
#
#   cmake -DHEADER=... -DBODY=... -DLANGUAGE=opencl|cuda -DOUTPUT=... -P embed.cmake
#
# The shared header is inlined into the body (the OpenCL and CUDA compilers get a
# single translation unit) and the result is written as a raw string literal.
if(NOT DEFINED HEADER OR NOT DEFINED BODY OR NOT DEFINED OUTPUT OR NOT DEFINED LANGUAGE)
  message(FATAL_ERROR "embed.cmake needs HEADER, BODY, OUTPUT and LANGUAGE")
endif()

# Inline every quoted include that sits next to the including file, so the
# device compiler sees one translation unit (a generated table header counts as
# part of the shared maths, not as a separate module).
get_filename_component(kernel_dir "${HEADER}" DIRECTORY)
file(READ "${HEADER}" header_text)
set(includes "")
string(REGEX MATCHALL "#include \"[a-z0-9_]+\.h\"" nested "${header_text}")
foreach(line IN LISTS nested)
  string(REGEX REPLACE "#include \"([a-z0-9_]+\.h)\"" "\\1" name "${line}")
  if(EXISTS "${kernel_dir}/${name}")
    file(READ "${kernel_dir}/${name}" nested_text)
    set(includes "${includes}${nested_text}\n")
    string(REPLACE "${line}" "" header_text "${header_text}")
  endif()
endforeach()
set(header_text "${includes}${header_text}")

file(READ "${BODY}" body_text)
string(REPLACE "#include \"av1gpu_kernels.h\"" "" body_text "${body_text}")
set(source "${header_text}\n${body_text}")

# The source becomes a raw string literal below, which cannot contain its own
# delimiter. Nothing does today; failing here says so at configure time instead
# of leaving a C++ compile error that points at generated code.
string(FIND "${source}" ")AV1GEMBED" delimiter_at)
if(NOT delimiter_at EQUAL -1)
  message(FATAL_ERROR "${BODY} contains the raw string delimiter used to embed it")
endif()

if(LANGUAGE STREQUAL "cuda")
  set(function "cuda")
else()
  set(function "opencl")
endif()

# The source is emitted as a sequence of concatenated raw string literals.
# One literal for the whole file breaks MSVC (C2026: a string literal may not
# be longer than 65535 bytes), so the pieces are kept comfortably below that.
set(chunk_size 16000)
string(LENGTH "${source}" source_len)
set(literals "")
set(offset 0)
while(offset LESS source_len)
  string(SUBSTRING "${source}" ${offset} ${chunk_size} chunk)
  string(APPEND literals "  R\"AV1GEMBED(${chunk})AV1GEMBED\"\n")
  math(EXPR offset "${offset} + ${chunk_size}")
endwhile()

set(payload "// generated by cmake/embed.cmake - do not edit
#include <string>

#include \"core/kernel_source.hpp\"

namespace av1gpu {
namespace internal {
namespace kernel_source {

const std::string& ${function}_generated() {
  static const std::string source =
${literals}  ;
  return source;
}

} /* namespace kernel_source */
} /* namespace internal */
} /* namespace av1gpu */
")
file(WRITE "${OUTPUT}" "${payload}")
